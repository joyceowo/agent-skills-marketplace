{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "systems"
  ],
  "properties": {
    "systems": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9]+(-[a-z0-9]+)*$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page_url": {
              "type": "string",
              "pattern": "^https://(app\\.notion\\.com|([a-z0-9-]+\\.)?notion\\.so|[a-z0-9-]+\\.notion\\.site)/[^\\s]+$"
            },
            "data_source_url": {
              "type": "string",
              "pattern": "^collection://([0-9a-fA-F]{32}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
            }
          },
          "anyOf": [
            {
              "required": [
                "page_url"
              ]
            },
            {
              "required": [
                "data_source_url"
              ]
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
