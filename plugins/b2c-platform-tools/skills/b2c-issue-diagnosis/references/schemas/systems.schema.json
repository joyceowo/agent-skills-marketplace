{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "systems"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "systems": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system_id",
          "name",
          "enabled"
        ],
        "properties": {
          "system_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "repository": {
            "const": "."
          },
          "root_path": {
            "type": "string",
            "minLength": 1
          },
          "read_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "write_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "docs_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 0
          },
          "log_sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "test_commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "build_command": {
            "type": "string",
            "minLength": 0
          },
          "shared_dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "diagnosis_mode": {
            "const": "read_only"
          },
          "allow_auto_fix": {
            "const": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "enabled": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "system_id",
                "name",
                "enabled",
                "repository",
                "root_path",
                "read_paths",
                "write_paths",
                "docs_paths",
                "log_sources",
                "test_commands",
                "build_command",
                "shared_dependencies",
                "diagnosis_mode",
                "allow_auto_fix"
              ]
            }
          }
        ]
      }
    }
  }
}
